{
  "name": "@osh/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm generate && pnpm typecheck && vite build && tsx ../../scripts/prepare-pages.ts",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "tsx ../../scripts/catalog.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-sanitize": "^6.0.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "@uas/skill-schema": "workspace:*",
    "fflate": "^0.8.3",
    "@uas/skill-validator": "workspace:*",
    "@uas/platform-adapters": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.1.12",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.19.0"
  },
  "license": "MIT"
}
