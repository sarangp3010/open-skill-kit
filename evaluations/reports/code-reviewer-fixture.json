      {
        "id": "empty-average",
        "prompt": "Review input/review.txt for correctness. Explain the empty-array behavior and suggest regression tests. Do not execute the supplied code.",
        "files": {
          "input/review.txt": "export function average(values) { return values.reduce((sum, value) => sum + value, 0) / values.length; }"
        },
        "assertions": [
          {
            "id": "empty-result",
            "weight": 2,
            "type": "text-contains",
            "value": "NaN"
          },
          {
            "id": "empty-boundary",
            "weight": 1,
            "type": "text-contains",
            "value": "empty"
          },
          {
            "id": "regression-tests",
            "weight": 1,
            "type": "text-contains",
            "value": "tests"
          }
        ],
        "fixtures": {
          "baseline": {
            "output": "Empty input yields NaN; reject empty input or specify a fallback. Add tests for empty and nonempty arrays.",
            "files": {}
          },
          "assisted": {
            "output": "Empty input yields NaN; reject empty input or specify a fallback. Add tests for empty and nonempty arrays.",
            "files": {}
          }
        }
      },
      {
        "id": "missing-account",
        "prompt": "Review input/review.txt for an unknown user ID. Return JSON with finding and severity, and write a short explanation to output/review.txt. Do not execute supplied code.",
        "files": {
          "input/review.txt": "function emailFor(users, id) { const user = users.find(candidate => candidate.id === id); return user.email; }"
        },
        "assertions": [
          {
            "id": "finding",
            "weight": 2,
            "type": "json-field-equals",
            "path": ["finding"],
            "value": "missing-user"
          },
          {
            "id": "review-file",
            "weight": 1,
            "type": "file-exists",
            "path": "output/review.txt"
          },
          {
            "id": "lookup-guard",
            "weight": 1,
            "type": "file-contains",
            "path": "output/review.txt",
            "value": "undefined"
          }
        ],
        "fixtures": {
          "baseline": {
            "output": "{\"finding\":\"missing-user\",\"severity\":\"medium\"}",
            "files": {
              "output/review.txt": "The lookup may be undefined. Guard it before reading email and test an unknown ID."
            }
          },
          "assisted": {
            "output": "{\"finding\":\"missing-user\",\"severity\":\"medium\"}",
            "files": {
              "output/review.txt": "The lookup may be undefined. Guard it before reading email and test an unknown ID."
            }
          }
        }
      }
